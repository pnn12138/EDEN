# ---- 选择 LLM Provider ----
# 可选值：volcengine | deepseek | mock
# 默认使用火山引擎：
LLM_PROVIDER=volcengine

# ---- 火山引擎配置（默认） ----
VOLCENGINE_API_KEY=your_volcengine_api_key_here
VOLCENGINE_BASE_URL=your_volcengine_base_url_here
VOLCENGINE_MODEL=your_volcengine_model_here

# ---- DeepSeek 配置（备选） ----
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 图像生成配置（离线素材生成，不建议接入游戏运行时） ----
# 可选值：manual | openai_compatible | minimax | volcengine | tencent | other
# manual 表示不由项目脚本自动调用，由人工生成后放入 public/assets/chapter0/images/
IMAGE_PROVIDER=manual
IMAGE_API_KEY=your_image_api_key_here
IMAGE_BASE_URL=your_image_base_url_here
IMAGE_MODEL=your_image_model_here
IMAGE_OUTPUT_DIR=public/assets/chapter0/images

# ---- 语音 / TTS 配置 ----
# 可选值：browser | openai_compatible | minimax | volcengine | tencent | azure | other
# browser 表示使用浏览器 Web Speech API，不需要服务端 key
TTS_PROVIDER=browser
TTS_API_KEY=your_tts_api_key_here
TTS_BASE_URL=your_tts_base_url_here
TTS_MODEL=your_tts_model_here
TTS_VOICE_ID=your_tts_voice_id_here
TTS_OUTPUT_DIR=public/assets/chapter0/audio/voice

# ---- 音效 / BGM 素材检索配置（可选） ----
# 当前项目已有音频素材；此配置仅用于后续从素材站点检索或下载可用素材
AUDIO_SEARCH_PROVIDER=manual
FREESOUND_API_KEY=your_freesound_api_key_here

# ---- 视频生成配置（可选，离线生成 Demo 素材 / 宣传视频片段） ----
# 可选值：manual | openai_compatible | minimax | runway | pika | luma | volcengine | tencent | other
VIDEO_PROVIDER=manual
VIDEO_API_KEY=your_video_api_key_here
VIDEO_BASE_URL=your_video_base_url_here
VIDEO_MODEL=your_video_model_here
VIDEO_OUTPUT_DIR=public/assets/chapter0/video

# ---- 音频识别 / ASR 配置（可选，后续若加入语音输入再使用） ----
# 可选值：browser | openai_compatible | whisper | minimax | volcengine | tencent | azure | other
ASR_PROVIDER=browser
ASR_API_KEY=your_asr_api_key_here
ASR_BASE_URL=your_asr_base_url_here
ASR_MODEL=your_asr_model_here
